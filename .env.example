GEMINI_API_KEY=your-gemini-api-key-here
QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-cloud-api-key-here
QDRANT_COLLECTION=report_agent_docs

# Optional -- omit to run without tracing. Free tier, no card required: https://langfuse.com
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://us.cloud.langfuse.com
